# ──────────────────────────────────────────────────────────────────────────
# BoomBigNose Company OS — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or real secrets. `.env.example` is the only env
# file tracked in git.
# ──────────────────────────────────────────────────────────────────────────

# Supabase — PUBLIC keys (safe to expose to the browser / client bundle).
# For local dev, `supabase start` prints these (API URL + anon key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Supabase — SECRET key (server-only).
# ⚠️  Used ONLY by the seed script (supabase/seed.sql tooling) to bypass RLS.
# ⚠️  NEVER import this into any file under app/, components/, or client code.
# ⚠️  NEVER prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# n8n inbound webhooks — the shared secret n8n must send as the
# `X-Webhook-Secret` header. Generate a long random value in production.
N8N_WEBHOOK_SECRET=change-me-use-a-long-random-string

# Optional: app URL used for absolute links / auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

