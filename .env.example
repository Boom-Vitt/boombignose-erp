# ──────────────────────────────────────────────────────────────────────────
# BoomBigNose ERP — environment variables
# Copy this file to `.env.local` and replace the required key placeholders.
# NEVER commit `.env.local` or real secrets. `.env.example` is the only env
# file tracked in git.
# ──────────────────────────────────────────────────────────────────────────

# Supabase — PUBLIC keys (safe to expose to the browser / client bundle).
# For local dev, `supabase start` prints these (API URL + anon key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Supabase — SECRET key (server-only).
# Bypasses RLS. Used by privileged server-only portal/command code and local
# administrative tooling; it is not limited to seeding.
# NEVER expose it in client components, browser bundles or logs.
# NEVER prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# n8n inbound webhooks — the shared secret n8n must send as the
# `X-Webhook-Secret` header. Generate a long random value in production.
N8N_WEBHOOK_SECRET=

# Optional: app URL used for absolute links / auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron / automation — shared secret the follow-up scan endpoint
# (/api/cron/followups) requires as the `X-Cron-Secret` header. Generate a long
# random value in production; a scheduler (n8n/Vercel Cron) calls it on a timer.
CRON_SECRET=

# Optional outbound n8n delivery. Leave both blank until explicitly configured.
# These values are server-only; never prefix either with NEXT_PUBLIC_.
N8N_OUTBOUND_URL=
N8N_OUTBOUND_SECRET=

# AI assists (deal summaries, follow-up drafts, meeting-summary intake).
# Server-only. OPTIONAL: when unset, AI features degrade gracefully — the UI
# shows a "configure OPENROUTER_API_KEY" notice instead of calling the model.
# Gemini 4 via OpenRouter (https://openrouter.ai).
OPENROUTER_API_KEY=
# Optional model override (defaults to google/gemini-4-argon in code).
OPENROUTER_MODEL=

# Email delivery (send quotes/invoices to clients via Resend over HTTP).
# Server-only. OPTIONAL: when unset, email features degrade gracefully — the UI
# shows an "Email not configured" notice instead of calling the provider.
RESEND_API_KEY=
# Optional from-address for outbound email (defaults to a sensible value in code).
EMAIL_FROM=

# ──────────────────────────────────────────────────────────────────────────
# Synthetic demo seed is for explicitly opted-in local testing only.
# See docs/testing/erp-gates.md before seeding; never use it for production.
# ──────────────────────────────────────────────────────────────────────────

# Optional local-dev "Use demo account" button on /login, off unless BOTH are
# set (e.g. to a seeded synthetic user). They are inlined into the browser
# bundle at build time, so never set them for a real deployment.
NEXT_PUBLIC_DEMO_LOGIN_EMAIL=
NEXT_PUBLIC_DEMO_LOGIN_PASSWORD=

# Build-time edition. Community works without ee/. Pro requires a commercial
# agreement and its database setup in docs/OPEN_CORE_BOUNDARY.md.
BBN_EDITION=community
